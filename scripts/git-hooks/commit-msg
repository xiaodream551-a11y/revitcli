#!/usr/bin/env bash
# scripts/git-hooks/commit-msg
#
# Lightweight Conventional Commit advisory. This hook no longer requires a
# Codex tick marker.

set -uo pipefail

MSG_FILE="${1:-}"
[ -f "$MSG_FILE" ] || exit 0

yellow(){ printf '\033[33m%s\033[0m\n' "$*"; }

first_line=$(grep -m1 -E -v '^(#|$)' "$MSG_FILE" 2>/dev/null || true)
[ -z "$first_line" ] && exit 0

case "$first_line" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*)
    exit 0
    ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|test|docs|ci|chore|refactor|perf|build)(\([^)]+\))?: .+'; then
  yellow "commit-msg advisory: prefer Conventional Commit subjects."
  yellow "Example: fix: handle null document path in status"
fi

exit 0
